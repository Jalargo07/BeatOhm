<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/regen_select_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="16dp" />

    <CheckBox
        android:id="@+id/check_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/regen_metadata"
        android:textColor="@color/on_surface"
        android:checked="true"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/check_lyrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/regen_lyrics"
        android:textColor="@color/on_surface"
        android:checked="false"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/check_waveform"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/regen_waveform"
        android:textColor="@color/on_surface"
        android:checked="false"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/check_artwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/regen_artwork"
        android:textColor="@color/on_surface"
        android:checked="false"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/check_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/regen_color"
        android:textColor="@color/on_surface"
        android:checked="false"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_retry_failed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/regen_retry_failed"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.TextButton"
        android:textColor="?attr/colorError" />

</LinearLayout>
